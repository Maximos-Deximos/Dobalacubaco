# Provedor de IA para chat
# ollama | openai | openrouter | groq | deepseek | anthropic | gemini
# O padrão é o Ollama local, que não exige chave de API.
AI_PROVIDER=ollama
AI_MODEL=qwen3.5:4b
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT=120
AI_MAX_TOKENS=2048

# Provedor de embeddings (busca semântica)
# ollama | openai | gemini | none
# "none" desativa embeddings e mantém apenas a busca lexical local.
AI_EMBED_PROVIDER=ollama
AI_EMBED_MODEL=bge-m3
AI_EMBED_API_KEY=
AI_EMBED_BASE_URL=

# Exemplos de provedores externos (descomente um bloco por vez)
# OpenAI:
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=sk-...
#
# OpenRouter:
# AI_PROVIDER=openrouter
# AI_MODEL=openai/gpt-4o-mini
# AI_API_KEY=sk-or-...
#
# Groq:
# AI_PROVIDER=groq
# AI_MODEL=llama-3.3-70b-versatile
# AI_API_KEY=gsk_...
#
# DeepSeek:
# AI_PROVIDER=deepseek
# AI_MODEL=deepseek-chat
# AI_API_KEY=sk-...
#
# Anthropic (somente chat; use outro provedor para embeddings):
# AI_PROVIDER=anthropic
# AI_MODEL=claude-3-5-haiku-latest
# AI_API_KEY=sk-ant-...
#
# Google Gemini:
# AI_PROVIDER=gemini
# AI_MODEL=gemini-2.0-flash
# AI_API_KEY=...
# AI_EMBED_PROVIDER=gemini
# AI_EMBED_MODEL=text-embedding-004

# Serviço local do Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_TIMEOUT=120

# RAG e chat local
RAG_CHUNK_CHARS=1800
RAG_CHUNK_OVERLAP=250
RAG_TOP_K=6
RAG_MAX_CONTEXT_CHARS=12000
RAG_EMBED_BATCH=16
# Quantas trocas antigas são enviadas ao modelo como contexto.
# A conversa completa continua salva no banco para consulta na TUI/CLI.
RAG_HISTORY_TURNS=6
RAG_TEMPERATURE=0.1

# Banco de dados etstá localizado na raiz do projeto

# Segurança
ALLOWED_DOMAINS=
DENIED_DOMAINS=
# Habilite apenas para testar formulários em localhost
ALLOW_PRIVATE_NETWORKS=false
SENSITIVE_FIELD_ACTION=confirm

# Navegador
# false abre uma janela visível durante o desenvolvimento
HEADLESS=false
MAX_ACTIONS=200
EXECUTION_TIMEOUT=180

# Ingestão de editais
ALLOW_HTTP=false
MAX_SOURCE_BYTES=20971520
MAX_PDF_BYTES=52428800
FETCH_TIMEOUT=30
MAX_REDIRECTS=5
MAX_LINKED_PDFS=10
FETCH_USER_AGENT=agente-editais-ia/0.1

# Logs
LOG_LEVEL=INFO
LOG_FILE=data/agent.log