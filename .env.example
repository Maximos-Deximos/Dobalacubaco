# Serviço local do Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_TIMEOUT=120

# RAG e chat local
RAG_CHUNK_CHARS=1800
RAG_CHUNK_OVERLAP=250
RAG_TOP_K=6
RAG_MAX_CONTEXT_CHARS=12000
RAG_EMBED_BATCH=16
RAG_HISTORY_TURNS=6
RAG_TEMPERATURE=0.1

# Banco de dados etstá localizado na raiz do projeto

# Segurança
ALLOWED_DOMAINS=
DENIED_DOMAINS=
# Habilite apenas para testar formulários em localhost
ALLOW_PRIVATE_NETWORKS=false
SENSITIVE_FIELD_ACTION=confirm

# Navegador
# false abre uma janela visível durante o desenvolvimento
HEADLESS=false
MAX_ACTIONS=200
EXECUTION_TIMEOUT=180

# Ingestão de editais
ALLOW_HTTP=false
MAX_SOURCE_BYTES=20971520
MAX_PDF_BYTES=52428800
FETCH_TIMEOUT=30
MAX_REDIRECTS=5
MAX_LINKED_PDFS=10
FETCH_USER_AGENT=agente-editais-ia/0.1

# Logs
LOG_LEVEL=INFO
LOG_FILE=data/agent.log