# Serviço local do Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT=120

# Banco de dados
# Deixe comentado para usar data/agent.db na raiz do projeto
# DATABASE_URL=sqlite:///data/agent.db

# Segurança
# Vazio permite domínios públicos; preencha para restringir
ALLOWED_DOMAINS=
DENIED_DOMAINS=
# Habilite apenas para testar formulários em localhost
ALLOW_PRIVATE_NETWORKS=false
SENSITIVE_FIELD_ACTION=confirm

# Navegador
# false abre uma janela visível durante o desenvolvimento
HEADLESS=false
MAX_ACTIONS=200
EXECUTION_TIMEOUT=180

# Logs
LOG_LEVEL=INFO
# LOG_FILE=data/agent.log
